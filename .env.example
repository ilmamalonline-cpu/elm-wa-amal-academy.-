# Copy to .env.local and fill in. Never commit .env.local.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>
# SERVER-ONLY. Bypasses RLS — never expose it to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service role / secret key>

# Zoom Server-to-Server OAuth app (scopes: meeting:write:admin [covers create + delete], meeting:read:admin)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# The licensed Zoom user that will own the meetings
ZOOM_HOST_EMAIL=
