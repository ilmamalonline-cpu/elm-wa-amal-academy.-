# Copy to .env.local and use the matching Supabase project URL/key.
# Do not reuse the production project's values while testing preview changes.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Set to true only for a private preview build so the interface explains the
# owner-only registration gate. Database policy is the actual enforcement.
NEXT_PUBLIC_ACADEMY_PREVIEW=false
